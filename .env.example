# Copy to .env. Never commit real values.
NODE_ENV=production
PRACTY_BASE_URL=https://practy.example.com.au
PRACTY_TENANT_ID=soul-legal
PRACTY_FIRM_NAME=Soul Legal
PRACTY_BOOTSTRAP_ADMIN_EMAIL=principal@example.com.au
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRACTY_SECRET_KEY=
DATABASE_URL=postgres://practy:practy@localhost:5432/practy

# Staff sign-in and Gmail/Calendar connection (Google Workspace OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=
# Or Microsoft Entra ID / Microsoft 365
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Xero (read-only trust/office records) and PracticePanther (matter import)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
PRACTICEPANTHER_CLIENT_ID=
PRACTICEPANTHER_CLIENT_SECRET=

# AI: either the Claude API...
ANTHROPIC_API_KEY=
# ...or Amazon Bedrock in Sydney (uses the AWS credential chain); set provider "bedrock" in Settings → AI
PRACTY_AWS_REGION=ap-southeast-2
# Model id for the chosen provider (also editable in Settings → AI)
PRACTY_AI_MODEL=

# Local document store (when not using Box), and background jobs (0 to disable)
PRACTY_LOCAL_DOCS=/app/data/documents
PRACTY_JOBS=1

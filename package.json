{
  "name": "practy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native practice management for plaintiff personal injury firms",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",

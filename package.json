{
  "name": "practy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-native practice management for plaintiff personal injury firms",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/main.js",
    "start:prod": "node --enable-source-maps dist/server/main.js"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.0",
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "docx": "^9.15.0",
    "docxtemplater": "^3.71.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "jose": "^6.2.14",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pizzip": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
